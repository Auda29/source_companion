{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Source Companion",
  "version": "0.1.0",
  "identifier": "dev.sourcecompanion.app",
  "build": {
    "beforeDevCommand": "node scripts/copy-desktop-assets.js",
    "beforeBuildCommand": "node scripts/copy-desktop-assets.js",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Source Companion",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://api.github.com https://github.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../src": "src"
    }
  }
}
